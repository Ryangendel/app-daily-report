# ─── Copy this file to ".env" and fill in your values. Never commit .env. ───

# ========== RevenueCat (subscriptions + revenue) ==========
# A V2 *secret* key (starts with "atk_"), with scope charts_metrics:overview:read.
# RevenueCat dashboard -> Project -> Settings -> API keys -> + New -> version "V2".
REVENUECAT_API_KEY=atk_xxxxxxxxxxxxxxxxxxxxxxxx
# Project -> Project Settings -> General -> "Project ID"
REVENUECAT_PROJECT_ID=proj_xxxxxxxx

# ========== App Store Connect (iOS downloads) ==========
# Users and Access -> Integrations -> App Store Connect API (Team Keys)
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_ID=XXXXXXXXXX
# Path to the AuthKey_XXXXXXXXXX.p8 file you downloaded (downloadable only once).
ASC_PRIVATE_KEY_PATH=/Users/ryangendel/Desktop/AppDailyReport/secrets/AuthKey.p8
# Payments and Financial Reports -> under your legal entity name (numeric)
ASC_VENDOR_NUMBER=8xxxxxxx

# ========== Google Play (Android downloads) ==========
# Path to the service-account JSON key you downloaded from Google Cloud.
GPLAY_SERVICE_ACCOUNT_FILE=/Users/ryangendel/Desktop/AppDailyReport/secrets/gplay-service-account.json
# From Play Console -> Download reports -> "Copy Cloud Storage URI" (drop the gs:// prefix).
GPLAY_BUCKET=pubsite_prod_rev_0123456789
# Your app's package name, e.g. com.fortituderanch.app
GPLAY_PACKAGE_NAME=com.fortituderanch.app

# ========== Email delivery (Gmail SMTP) ==========
GMAIL_ADDRESS=gendel.ryan@gmail.com
# A Gmail App Password (16 chars). https://myaccount.google.com/apppasswords
# Requires 2-Step Verification on the Google account. Paste without spaces.
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Recipient of the report
REPORT_TO=manager@example.com

# Advanced (defaults are fine for Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
